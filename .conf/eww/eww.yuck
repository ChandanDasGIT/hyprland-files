(defvar todo "")
(defvar shortcuts "")

(defwindow notes
  :monitor 0
  :geometry (geometry
    :x "60px"
    :y "60px"
    :width "1000px"
    :height "600px"
    :anchor "top center")
  :stacking "fg"
  :focusable false
  :exclusive false
  :wm-ignore false

  (box
    :class "notes-container"
    :orientation "h"
    :spacing 20
    :space-evenly true

    (box
      :class "notes-panel"
      :orientation "v"
      :space-evenly false


      (label
        :class "notes-title"
        :text "TO-DO")

      (scroll
        :vscroll true
        :hscroll false
        :vexpand true
        (label
          :class "notes-text"
          :text todo
          :wrap true
          :wrap-mode "wordchar"
          :show-truncated false
          :xalign 10
          :valign "start")))

    (box
      :class "notes-panel"
      :orientation "v"
      :space-evenly false
      :hexpand false
      :vexpand false

      (label
        :class "notes-title"
        :text "SHORTCUTS")

      (scroll
        :vscroll true
        :hscroll false
        :vexpand true
        :limit-width 50
        (label
          :class "notes-text"
          :text shortcuts
          :wrap true
          :wrap-mode "wordchar"
          :truncate true
          :show-truncated false
          :xalign 0
          :valign "start")))))
