    "custom/cava": {
        "exec": "cava -p ~/.config/cava/config_waybar | sed -u 's/;//g;s/0/ /g;s/1/▂/g;s/2/▃/g;s/3/▄/g;s/4/▅/g;s/5/▆/g;s/6/▇/g;s/7/█/g'",
//        "exec": "cava -p ~/.config/cava/config_waybar",
//        "exec": "~/.config/waybar/cava.sh",
        "tooltip": false,
        "return-type": "plain",
        "format": "{}",
        "min-width": 5,
